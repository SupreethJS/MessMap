# =============================================================================
# SMART MESS MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION (.env)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Supabase Database & Auth (Required for Production on Vercel)
# -----------------------------------------------------------------------------
# Retrieve from: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# -----------------------------------------------------------------------------
# 2. Operating & Demo Mode Configuration
# -----------------------------------------------------------------------------
# Set to 'true' to run in mock mode with in-memory seed data without Supabase.
# Set to 'false' (or leave unset) for live Supabase PostgreSQL serverless production.
NEXT_PUBLIC_DEMO_MODE=false

# -----------------------------------------------------------------------------
# 3. College Domain Restrictions (Optional)
# -----------------------------------------------------------------------------
# Comma-separated list of permitted email domains for student/admin accounts.
# Example: msruas.ac.in,college.edu
# Leave blank or set to * to permit all valid email addresses.
ALLOWED_EMAIL_DOMAINS=msruas.ac.in,college.edu

# -----------------------------------------------------------------------------
# 4. Application Base URL
# -----------------------------------------------------------------------------
# Local development: http://localhost:3000
# Production on Vercel: https://your-project.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# 5. Default Meal Cutoff Schedules (HH:MM in 24-hour format)
# -----------------------------------------------------------------------------
DEFAULT_BREAKFAST_CUTOFF_TIME=06:00
DEFAULT_LUNCH_CUTOFF_TIME=10:00
DEFAULT_DINNER_CUTOFF_TIME=17:00

# -----------------------------------------------------------------------------
# 6. Initial Admin Provisioning Credentials
# -----------------------------------------------------------------------------
INITIAL_ADMIN_EMAIL=admin@msruas.ac.in
INITIAL_ADMIN_PASSWORD=SecureAdminPassword123!
INITIAL_ADMIN_NAME="Mess Head Administrator"

# -----------------------------------------------------------------------------
# 7. Google SMTP Email Service (Optional: for live OTP & Welcome emails)
# -----------------------------------------------------------------------------
# If unconfigured, the registration flow will display the OTP directly on-screen
# so evaluation and testing are never blocked.
GOOGLE_SMTP_USER=
GOOGLE_SMTP_PASS=
GOOGLE_SMTP_HOST=smtp.gmail.com
GOOGLE_SMTP_PORT=465
GOOGLE_SMTP_SECURE=true
GOOGLE_SMTP_FROM="Smart Mess <no-reply@college.edu>"
